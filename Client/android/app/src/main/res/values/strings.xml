    <string name="notify_action_pause">暂停上报</string>
    <string name="notify_action_resume">恢复上报</string>
    <string name="notify_action_stop">停止采集</string>
    <string name="notify_service_enabled">无障碍服务已启用，开始采集前台应用</string>
    <string name="notify_service_disabled">无障碍服务已停止，采集已结束</string>
    <string name="notify_accessibility_needed">需要启用无障碍服务后才会开始采集（点击打开设置）</string>
